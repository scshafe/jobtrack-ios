# Copy to project.local.yml (git-ignored) on your Mac, put in your team, and
# generate the project from it instead of project.yml:
#   cp project.local.yml.example project.local.yml
#   xcodegen generate --spec project.local.yml
# It includes project.yml and only adds this Mac's signing settings.
include:
  - project.yml
settings:
  base:
    DEVELOPMENT_TEAM: ABCDE12345   # your Team ID: 10 characters, not a secret
    CODE_SIGN_STYLE: Automatic
